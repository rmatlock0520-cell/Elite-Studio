<Project>
  <PropertyGroup>
    <!-- Compiler output goes outside OneDrive (one folder per checkout) so sync never locks build files. -->
    <ArtifactsPath>$(UserProfile)\.elite-studio\build\$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($(MSBuildThisFileDirectory)))))</ArtifactsPath>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.7.3</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
