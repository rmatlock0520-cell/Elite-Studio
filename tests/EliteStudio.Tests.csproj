<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <RootNamespace>EliteStudio.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- Keep test reports out of the project folder. -->
    <TestingPlatformCommandLineArguments>--results-directory "$(ArtifactsPath)\TestResults"</TestingPlatformCommandLineArguments>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\src\EliteStudio.csproj" />
    <Using Include="Xunit" />
    <Using Include="System.IO" />
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
</Project>
